# BeeMonitor SageMaker GPU **training** image (BYOC).
#
# Built + pushed to ECR by .github/workflows/build-sagemaker-image.yml — NEVER
# built locally (the dev Mac has no NVIDIA GPU). Build context is the repo root:
#
#   DOCKER_BUILDKIT=1 docker build \
#     -f sagemaker_backend/Dockerfile.training \
#     -t beemonitor-sm-dev-training .
#
# SageMaker starts a training job as `docker run <image> train`, which runs the
# `train` wrapper -> train.py. See train.py for the manifest/IO contract.

FROM nvidia/cuda:12.6.3-cudnn-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONPATH=/opt/program \
    PATH=/opt/program:$PATH

RUN apt-get update && apt-get install -y --no-install-recommends \
        python3 python3-pip python3-dev \
        libgl1 libglib2.0-0 \
        ffmpeg \
        ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && ln -sf /usr/bin/python3 /usr/local/bin/python

# torch from the CUDA 12.6 wheel index, in its own layer (same pin as inference).
RUN python -m pip install --upgrade pip \
    && python -m pip install \
        --index-url https://download.pytorch.org/whl/cu126 \
        torch==2.9.1 torchvision==0.24.1

COPY sagemaker_backend/requirements.train.txt /tmp/requirements.train.txt
RUN python -m pip install -r /tmp/requirements.train.txt

WORKDIR /opt/program
COPY sagemaker_backend/train.py sagemaker_backend/train /opt/program/
RUN chmod +x /opt/program/train
