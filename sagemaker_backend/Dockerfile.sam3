# BeeMonitor SAM 3 auto-labeler inference image (BYOC, GPU).
#
# Built + pushed to ECR by CI (.github/workflows/build-sagemaker-image.yml), NEVER
# locally. Runs on a GPU SageMaker async endpoint (scale-to-zero) used at *label*
# time to bootstrap YOLO training data for new-domain footage.
#
# facebook/sam3 is a GATED model: the build BAKES the weights into the image using a
# BuildKit secret `hf_token` (CI passes the `HF_TOKEN` GitHub secret) so a
# scale-from-zero cold start doesn't re-download multiple GB, and the runtime reads
# them from cache (offline). Build context is the repo root:
#   DOCKER_BUILDKIT=1 docker build -f sagemaker_backend/Dockerfile.sam3 \
#     --secret id=hf_token,env=HF_TOKEN --platform linux/amd64 -t beemonitor-sam3-dev .

FROM nvidia/cuda:12.6.3-cudnn-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONPATH=/opt/program \
    PATH=/opt/program:/usr/bin:$PATH \
    HF_HOME=/opt/program/.hf

RUN apt-get update && apt-get install -y --no-install-recommends \
        python3 python3-pip libgl1 libglib2.0-0 ca-certificates git \
    && ln -sf /usr/bin/python3 /usr/bin/python \
    && rm -rf /var/lib/apt/lists/*

# torch from the CUDA 12.6 wheel index, in its own layer (matches Dockerfile.gpu).
RUN python -m pip install --upgrade pip \
    && python -m pip install --index-url https://download.pytorch.org/whl/cu126 \
        torch==2.9.1 torchvision==0.24.1

COPY sagemaker_backend/requirements.sam3.txt /tmp/req.txt
RUN python -m pip install -r /tmp/req.txt

WORKDIR /opt/program
COPY sagemaker_backend/sam3/ /opt/program/
RUN chmod +x /opt/program/serve

# Bake the gated facebook/sam3 + facebook/dinov3 weights (BuildKit secret — never
# stored in a layer). The build FAILS here if the HF_TOKEN secret is missing or
# EITHER license isn't accepted; that's intended (the endpoint is useless without
# both models). Accept licenses at hf.co/facebook/sam3 AND hf.co/facebook/dinov3-vitb16-pretrain-lvd1689m.
RUN --mount=type=secret,id=hf_token \
    HF_TOKEN="$(cat /run/secrets/hf_token 2>/dev/null || true)" \
    python -c "import os; \
from transformers import Sam3Model, Sam3Processor, AutoModel, AutoImageProcessor; \
t=os.environ.get('HF_TOKEN') or None; \
Sam3Processor.from_pretrained('facebook/sam3', token=t); \
Sam3Model.from_pretrained('facebook/sam3', token=t); \
AutoImageProcessor.from_pretrained('facebook/dinov3-vitb16-pretrain-lvd1689m', token=t); \
AutoModel.from_pretrained('facebook/dinov3-vitb16-pretrain-lvd1689m', token=t)"

# Runtime: read baked weights only — no HF Hub round-trips on cold start.
ENV HF_HUB_OFFLINE=1 \
    TRANSFORMERS_OFFLINE=1

EXPOSE 8080
