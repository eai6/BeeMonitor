# Copy this to .env and fill in your values
# cp .env.example .env

# Django
DJANGO_SECRET_KEY=change-me-to-a-random-string
DJANGO_ENV=development

# Azure Blob Storage (get from Azure Portal → Storage Account → Access Keys)
AZURE_STORAGE_CONNECTION_STRING=

# Redis (local default)
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Credential encryption key (REQUIRED for storing cloud source credentials)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# SOC2 CC6.1: This key encrypts all stored cloud credentials (S3, GCS, etc.)
# NEVER commit this key to git. Rotate every 90 days.
BEEMONITOR_CREDENTIAL_KEY=

# Modal (get from https://modal.com/settings)
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# Database (production only, dev uses SQLite)
# DB_NAME=beemonitor
# DB_USER=beemonitor
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=5432

# ── SECURITY NOTES (SOC2 Compliance) ──
# - All cloud credentials are encrypted at rest with Fernet (AES-128-CBC + HMAC)
# - Credentials are NEVER logged — error messages are redacted
# - Audit trail: all credential create/test/delete actions logged
# - Access keys should use least-privilege IAM policies
# - Rotate BEEMONITOR_CREDENTIAL_KEY and cloud access keys every 90 days
# - Enable MFA on all cloud provider accounts
