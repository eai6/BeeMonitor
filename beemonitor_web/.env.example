# Copy this to .env and fill in your values
# cp .env.example .env

# Django
DJANGO_SECRET_KEY=change-me-to-a-random-string
DJANGO_ENV=development

# Azure Blob Storage (get from Azure Portal → Storage Account → Access Keys)
AZURE_STORAGE_CONNECTION_STRING=

# Redis (local default)
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Credential encryption (auto-generated, keep secret)
BEEMONITOR_CREDENTIAL_KEY=

# Modal (get from https://modal.com/settings)
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# Database (production only, dev uses SQLite)
# DB_NAME=beemonitor
# DB_USER=beemonitor
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=5432
