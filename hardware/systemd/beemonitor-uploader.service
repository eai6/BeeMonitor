[Unit]
Description=BeeMonitor Pi -> S3 uploader
Documentation=https://github.com/eai6/BeeMonitor
# Don't start until we have a real network. On a cellular unit that route comes
# from cellular.service (Sixfab QMI bring-up), so order after it. The uploader's
# own retry/backoff covers the gap if the link isn't fully up the instant it
# starts, so this is ordering, not a hard requirement.
After=network-online.target cellular.service
Wants=network-online.target cellular.service
# Run independently of the recorder so a recorder crash doesn't stop uploads
# (and a network blip doesn't stop recording).

[Service]
Type=simple
User=beemonitor
Group=beemonitor
# Environment lives in this file (chmod 600) — keeps the bmk_device_* key
# out of the unit file itself.
EnvironmentFile=/etc/beemonitor/uploader.env
ExecStart=/home/beemonitor/BeeMonitor/hardware/venv/bin/python /home/beemonitor/BeeMonitor/hardware/uploader.py
Restart=on-failure
# Give the script a moment to drain on SIGTERM before SIGKILL.
TimeoutStopSec=300
# Don't hammer if it keeps failing.
RestartSec=10
StartLimitIntervalSec=600
StartLimitBurst=5
# Logs go to journalctl -u beemonitor-uploader.
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
