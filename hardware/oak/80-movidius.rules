# Luxonis OAK (Movidius MyriadX / RVC2) — let non-root users open the device.
# Without it depthai sees the camera but cannot talk to it ("Insufficient
# permissions ... X_LINK_UNBOOTED"). 03e7 covers the unbooted (2485), booted
# (f63b) and bootloader (f63c) product IDs the device cycles through.
#
# Install:
#   sudo cp hardware/oak/80-movidius.rules /etc/udev/rules.d/
#   sudo udevadm control --reload-rules && sudo udevadm trigger --attr-match=idVendor=03e7
# (hardware/provision.sh does this on every update.)
SUBSYSTEM=="usb", ATTRS{idVendor}=="03e7", MODE="0666"
