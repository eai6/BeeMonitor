# Sixfab / libqmi packet-data session config.
# Install to /etc/qmi-network.conf  (read by `qmi-network` in cellular-up.sh).
#
#   sudo cp qmi-network.conf.sample /etc/qmi-network.conf
#   # Default below works as-is for the Sixfab SIM; only edit for another carrier:
#   sudo nano /etc/qmi-network.conf   # set APN for your SIM
#
# Set APN to your carrier's value, e.g.:
#   Sixfab SIM       -> super   (Sixfab resells the Twilio Super SIM)
#   Twilio Super SIM -> super
#   Hologram         -> hologram
#   Soracom          -> soracom.io

# Default APN for the Sixfab SIM (the SIM that ships with the kit).
APN=super
# APN_USER=
# APN_PASS=

# Request an IPv4-only data session. Most IoT carriers (incl. the Sixfab/Twilio
# Super SIM) only grant IPv4; if we ask for the default dual-stack IPv4v6 the
# network rejects the call with "ipv4-only-allowed" (QMI error 14 'CallFailed')
# and wwan0 never gets an address. Force IPv4 to avoid that. Set to 6 only if
# your carrier is genuinely IPv6-only.
IP_TYPE=4
