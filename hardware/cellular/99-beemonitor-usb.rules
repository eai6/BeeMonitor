# Auto-copy BeeMonitor recordings when ANY USB drive is plugged in (no label
# needed). The transfer is idempotent (per-clip .usb sidecars), so re-plugging
# only copies new clips.
#
# Install:
#   sudo cp hardware/cellular/99-beemonitor-usb.rules /etc/udev/rules.d/
#   sudo cp hardware/systemd/beemonitor-usb-transfer@.service /etc/systemd/system/
#   sudo udevadm control --reload && sudo systemctl daemon-reload
ACTION=="add", SUBSYSTEM=="block", ENV{ID_BUS}=="usb", ENV{DEVTYPE}=="partition", RUN+="/usr/bin/systemctl start beemonitor-usb-transfer@%k.service"
