# beemonitor.conf — per-card provisioning, dropped on the FAT *boot* partition
# (/boot/firmware/beemonitor.conf on Bookworm). Written by the browser installer
# on the enrollment page, or by prepare-card.sh. enroll.py reads it on first boot,
# registers the device, then clears the token line from this file.
#
# Only these two keys are used here; everything else lives in
# /etc/beemonitor/uploader.env on the running Pi.
BEEMONITOR_API_BASE=https://mqnafc3ejc.us-east-1.awsapprunner.com
BEEMONITOR_ENROLL_TOKEN=bmk_enroll_replace_me
